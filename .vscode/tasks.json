{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite dev server",
      "type": "npm",
      "script": "dev",
      "args": ["--", "--strictPort"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*http://localhost:5173/"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
