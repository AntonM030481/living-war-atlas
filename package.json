{
  "name": "living-war-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest bench",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:sim:raw": "vitest bench tests/perf --no-file-parallelism",
    "diagnostics": "vitest run tests/diagnostics/generate-diagnostics.test.ts",
    "ios:init": "npm run build && npx cap add ios && npx cap open ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "pixi.js": "^8.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@0.3.3": true
  }
}
