{
  "name": "living-war-atlas",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/version.mjs --write-web",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest bench",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:sim:raw": "vitest bench tests/perf --no-file-parallelism",
    "diagnostics": "vitest run tests/diagnostics",
    "version:info": "node scripts/version.mjs",
    "deploy": "node scripts/version.mjs --deploy",
    "ios:init": "npm run build && npx cap add ios && node scripts/version.mjs --sync-ios && npx cap open ios",
    "ios:sync": "npm run build && node scripts/version.mjs --sync-ios && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "pixi.js": "^8.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.127.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260826.1": true
  }
}
